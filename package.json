{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/src/server.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/src/server.js",
    "dev:client": "npm run dev --workspace=client -- --host 0.0.0.0",
    "start": "node server/src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@photostructure/sqlite": "^3.3.1",
    "@tavily/core": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14"
  }
}
